# ============================================================
# Smriti Pass — Heritage Commerce Environment Configuration
# ============================================================

# Server port (default: 3001)
PORT=3001

# MongoDB connection string (optional — server runs in high-performance in-memory mode without it)
# MONGODB_URI=mongodb://localhost:27017/smritipass

# Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Partner commissions (calculated from within Smriti Pass's 30% company share)
# Guide commission percentage of product price (e.g., 5%)
GUIDE_COMMISSION_PCT=5

# Hotel partner commission percentage of product price (e.g., 5%)
HOTEL_COMMISSION_PCT=5

# Google Gemini AI API Key for Voice Bot & Craft Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
